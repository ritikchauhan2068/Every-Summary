# Gemini Developer API key from Google AI Studio. Leave empty for extractive mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional overrides. Set GEMINI_EMBEDDING_MODEL= for keyword-only retrieval.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Persistent SQLite database, uploads in flight, and worker concurrency.
# SOURCEWISE_DATA=./data
INGEST_WORKERS=2
COOKIE_SECURE=false

# Automatic captions and local transcription.
YOUTUBE_CAPTION_LANGUAGES=en
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OCR_LANGUAGE=eng
# YOUTUBE_COOKIES_FILE=/absolute/path/to/server-owned-cookies.txt

# Optional operator-controlled egress proxy. Its policy must block nonpublic targets.
# TRUSTED_FETCH_PROXY=http://proxy.example:3128
